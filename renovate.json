{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config",
    "github>tjorim/renovate-config:js",
    "github>tjorim/renovate-config:python",
    "github>tjorim/renovate-config:android"
  ],
  "packageRules": [
    {
      "description": [
        "msw 3.0.4 reworks the service worker (active clients are stored in Cache Storage and restored on every wake-up). With it the e2e suite intermittently fails: pages stay on the loading state or show 'This page could not be loaded' (theme.spec.ts, dialogs, registry coverage). msw 3.0.3 passes 87/87. Remove this rule once a later msw release passes the e2e suite."
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "msw"
      ],
      "allowedVersions": "<3.0.4"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "canvas-confetti",
        "@types/canvas-confetti"
      ],
      "groupName": "canvas-confetti"
    },
    {
      "description": [
        "Schedule-X calendar component and its plugins"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@schedule-x/*"
      ],
      "groupName": "schedule-x"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "dayjs"
      ],
      "groupName": "dayjs"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "custom_components/**"
      ],
      "matchPackageNames": [
        "pyobjc-*"
      ],
      "groupName": "pyobjc"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "custom_components/**"
      ],
      "matchPackageNames": [
        "winrt-*"
      ],
      "groupName": "winrt"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "python-daynest/**"
      ],
      "matchPackageNames": [
        "pytest*",
        "ruff",
        "pyright",
        "nodeenv"
      ],
      "groupName": "python-dev"
    },
    {
      "description": [
        "frontend/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "addLabels": [
        "platform:frontend"
      ]
    },
    {
      "description": [
        "dashboard/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "dashboard/**"
      ],
      "addLabels": [
        "platform:dashboard"
      ]
    },
    {
      "description": [
        "pebble/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "pebble/**"
      ],
      "addLabels": [
        "platform:pebble"
      ],
      "commitMessagePrefix": "deps(pebble):"
    },
    {
      "description": [
        "backend/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "addLabels": [
        "platform:backend"
      ],
      "commitMessagePrefix": "deps(backend):"
    },
    {
      "description": [
        "custom_components/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "custom_components/**"
      ],
      "addLabels": [
        "platform:home-assistant"
      ],
      "commitMessagePrefix": "deps(ha):"
    },
    {
      "description": [
        "python-daynest/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "python-daynest/**"
      ],
      "addLabels": [
        "platform:python-lib"
      ],
      "commitMessagePrefix": "deps(lib):"
    },
    {
      "description": [
        "android/**"
      ],
      "matchManagers": [
        "gradle"
      ],
      "matchFileNames": [
        "android/**"
      ],
      "addLabels": [
        "platform:android"
      ],
      "commitMessagePrefix": "deps(android):"
    }
  ]
}
