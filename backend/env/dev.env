ENVIRONMENT=dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=daynest
DB_USER=daynest
DB_PASSWORD_FILE=/run/secrets/postgres_password
OIDC_ISSUER_URL=http://keycloak:8080/realms/daynest
OIDC_ALGORITHMS=RS256
# Home Assistant OIDC client advertised by /api/integrations/home-assistant/oidc-config.
# Set this to the client ID configured in your identity provider (default: home-assistant).
OIDC_HOME_ASSISTANT_CLIENT_ID=home-assistant
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
