# Normalise text to LF on commit and checkout. The only tracked CRLF file is android/gradlew.bat (kept below), so
# this changes no existing file.
* text=auto eol=lf
*.bat text eol=crlf

# Binary assets (listed one per pattern: .gitattributes has no brace expansion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
