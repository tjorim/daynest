{
  "repo": "tjorim/daynest",
  "targets": [
    { "file": "frontend/package.json", "pattern": "\"version\": \"([^\"]+)\"" },
    { "file": "dashboard/package.json", "pattern": "\"version\": \"([^\"]+)\"" },
    {
      "file": "custom_components/daynest/manifest.json",
      "pattern": "(?:\"version\": \"|python-daynest==)([^\"]+)\"",
      "expect": 2
    },
    { "file": "python-daynest/pyproject.toml", "pattern": "\\nversion = \"([^\"]+)\"" },
    { "file": "python-daynest/uv.lock", "pattern": "name = \"python-daynest\"\\nversion = \"([^\"]+)\"" }
  ],
  "scopes": ["Web", "Android", "Wear OS", "Pebble", "Backend", "MCP", "Home Assistant", "Library"],
  "platforms": ["Web", "Android", "Wear OS", "Pebble"]
}
