{
  "name": "daynest-frontend",
  "version": "2026.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MSW=true vite",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "check-message-parity": "node scripts/check-message-parity.mjs",
    "locale:audit": "node scripts/locale-audit.mjs",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "build:mock": "msw init public --save && cross-env VITE_MSW=true pnpm build",
    "preview": "vite preview",
    "postinstall": "msw init public --save",
    "typecheck": "pnpm paraglide:compile && pnpm api:check && tsc -b --noEmit",
    "api:generate": "node scripts/api-types.mjs generate",
    "api:check": "node scripts/api-types.mjs check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:repo": "cd .. && frontend/node_modules/.bin/oxfmt -c frontend/.oxfmtrc.json .github scripts *.json",
    "format:repo:check": "cd .. && frontend/node_modules/.bin/oxfmt --check -c frontend/.oxfmtrc.json .github scripts *.json",
    "ui:check": "node scripts/ui-maintenance.mjs check && node scripts/ui-imports.mjs",
    "ui:upstream": "node scripts/ui-maintenance.mjs upstream",
    "ui:test": "node --test scripts/ui-maintenance.verify.mjs scripts/ui-imports.verify.mjs",
    "ui:usage": "node scripts/ui-imports.mjs",
    "bundle:report": "node scripts/bundle-budget.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "bundle:test": "node --test scripts/bundle-budget.verify.mjs",
    "test:compatibility:runtime": "vitest run -c vitest.redact.config.ts",
    "test:compatibility:browsers": "playwright test -c playwright.compatibility.config.ts",
    "test:compatibility": "pnpm test:compatibility:runtime && pnpm test:compatibility:browsers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/event-modal": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.9.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/react-form": "2.0.0-alpha.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "canvas-confetti": "^1.9.4",
    "cn": "^0.5.2",
    "d3-shape": "^3.2.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.71.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-oidc-context": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@tanstack/redact": "0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.4",
    "orval": "8.47.0",
    "oxc-parser": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
