{
  "name": "daynest-frontend",
  "version": "2026.8.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MSW=true vite",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "build:mock": "cross-env VITE_MSW=true pnpm build",
    "preview": "vite preview",
    "postinstall": "msw init public --save",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.2",
    "@inlang/plugin-m-function-matcher": "^2.2.15",
    "@inlang/plugin-message-format": "^4.4.4",
    "@schedule-x/calendar": "^4.8.0",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/event-modal": "^4.8.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.8.0",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^9.2.4",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "canvas-confetti": "^1.9.4",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.23",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^19.3.0",
    "react-oidc-context": "^3.3.1",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
